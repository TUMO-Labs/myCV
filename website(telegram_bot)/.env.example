# ── TELEGRAM BOT TOKEN ────────────────────────────────────────────────────────
# Get from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ── TELEGRAM GROUP ID ─────────────────────────────────────────────────────────
# This is the group chat ID — always a NEGATIVE number like -1001234567890
#
# How to get it:
#   1. Add your bot to the group
#   2. Make the bot Admin (give it ALL permissions to be safe)
#   3. Send any message in the group
#   4. Open this URL in your browser (replace YOUR_TOKEN):
#      https://api.telegram.org/botYOUR_TOKEN/getUpdates
#   5. Find "chat":{"id":-100XXXXXXXXX, "type":"supergroup"...}
#      That negative number is your GROUP_ID
#
# IMPORTANT: It must start with - (minus sign)
TELEGRAM_GROUP_ID=-100YOUR_GROUP_ID_HERE

# ── PORT ──────────────────────────────────────────────────────────────────────
PORT=3000
